# ==============================================================
# Python (general)
# ==============================================================
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
.eggs/
build/
dist/
wheels/
*.whl
*.manifest
*.spec

# Virtual environments
.venv/
venv/
env/
ENV/

# Python test / coverage artifacts
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
hypothesis/

# IPython / notebooks
.ipynb_checkpoints/
*~
*.ipynb_checkpoints

# ==============================================================
# Sensitive configuration & secrets
# ==============================================================
# NEVER commit API keys, endpoints, or connection strings.
# Keep a committed .env.example with placeholder values instead.
.env
.env.local
.env.*.local
.env.production
.env.development

# IDE configuration files (.idea should be individually decided)
.idea/
.vscode/
*.code-workspace
*.swp
*.swo

# ==============================================================
# Raw data & generated artifacts (large or reproducible)
# ==============================================================
# The PDFs and Markdown reports are generated/generated by the
# ingestion pipeline; keeping them out keeps the repo light.
Data/
reports_markdown/
*.pdf
*.md.tmp

# ==============================================================
# Operating system files
# ==============================================================
.DS_Store
Thumbs.db
desktop.ini

# ==============================================================
# Logs
# ==============================================================
*.log
logs/
**/logs/

# ==============================================================
# Temporary / editor scratch files
# ==============================================================
tmp/
temp/
*.tmp
*.bak
*.orig
